import threading
import time
import urllib.parse
import webbrowser
from kivy.app import App
from kivy.core.window import Window
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.gridlayout import GridLayout
from kivy.uix.label import Label
from kivy.uix.scrollview import ScrollView
from kivy.uix.textinput import TextInput

Window.clearcolor = (0.12, 0.05, 0.08, 1)


class LinkMovieApp(App):

    def build(self):
        root = ScrollView()
        layout = BoxLayout(
            orientation="vertical",
            padding=15,
            spacing=12,
            size_hint_y=None,
        )
        layout.bind(minimum_height=layout.setter("height"))

        # Header
        header = BoxLayout(size_hint_y=None, height=50, spacing=10)
        title_label = Label(
            text="Link Movie",
            font_size="24sp",
            bold=True,
            color=(1, 0.3, 0.5, 1),
        )
        btn_share = Button(
            text="Share App",
            background_color=(0.2, 0.8, 0.4, 1),
            size_hint_x=0.4,
        )
        btn_share.bind(on_press=self.share_app)
        header.add_widget(title_label)
        header.add_widget(btn_share)
        layout.add_widget(header)

        # Search Input
        self.input_box = TextInput(
            hint_text="Clip Link ya Movie Ka Naam Search Karein...",
            multiline=False,
            size_hint_y=None,
            height=50,
            background_color=(0.2, 0.1, 0.15, 1),
            foreground_color=(1, 1, 1, 1),
        )
        layout.add_widget(self.input_box)

        # Search Buttons
        btn_grid = GridLayout(cols=2, spacing=10, size_hint_y=None, height=50)
        btn_google = Button(
            text="Google Search", background_color=(0.9, 0.2, 0.4, 1)
        )
        btn_google.bind(on_press=self.search_google)
        btn_yt = Button(
            text="YouTube Search", background_color=(1, 0.1, 0.1, 1)
        )
        btn_yt.bind(on_press=self.search_youtube)

        btn_grid.add_widget(btn_google)
        btn_grid.add_widget(btn_yt)
        layout.add_widget(btn_grid)

        # Direct Download
        btn_download = Button(
            text="Direct Movie Download",
            background_color=(0.8, 0.1, 0.3, 1),
            size_hint_y=None,
            height=45,
        )
        btn_download.bind(on_press=self.download_movie)
        layout.add_widget(btn_download)

        # OTT Section
        layout.add_widget(
            Label(
                text="FREE OTT & STREAMING APPS",
                size_hint_y=None,
                height=30,
                color=(0.8, 0.8, 0.8, 1),
            )
        )
        ott_grid1 = GridLayout(cols=2, spacing=10, size_hint_y=None, height=80)
        btn_flix = Button(
            text="FlixFox App", background_color=(0.15, 0.15, 0.15, 1)
        )
        btn_jio = Button(
            text="JioCinema / MX", background_color=(0.15, 0.15, 0.15, 1)
        )
        btn_flix.bind(
            on_press=lambda x: self.open_ott("https://www.google.com/search?q=FlixFox")
        )
        btn_jio.bind(
            on_press=lambda x: self.open_ott("https://www.jiocinema.com")
        )
        ott_grid1.add_widget(btn_flix)
        ott_grid1.add_widget(btn_jio)
        layout.add_widget(ott_grid1)

        layout.add_widget(
            Label(
                text="PAID / RECHARGE APPS",
                size_hint_y=None,
                height=30,
                color=(0.8, 0.8, 0.8, 1),
            )
        )
        ott_grid2 = GridLayout(cols=2, spacing=10, size_hint_y=None, height=80)
        btn_netflix = Button(
            text="Netflix / Prime", background_color=(0.2, 0.2, 0.6, 1)
        )
        btn_hotstar = Button(
            text="Hotstar / Zee5", background_color=(0.2, 0.2, 0.6, 1)
        )
        btn_netflix.bind(
            on_press=lambda x: self.open_ott("https://www.netflix.com")
        )
        btn_hotstar.bind(
            on_press=lambda x: self.open_ott("https://www.hotstar.com")
        )
        ott_grid2.add_widget(btn_netflix)
        ott_grid2.add_widget(btn_hotstar)
        layout.add_widget(ott_grid2)

        root.add_widget(layout)
        return root

    # ADS MANAGEMENT SYSTEM
    def start_movie_session(self):
        print("Initial 1-2 Interstitial Ads Loaded")

        def mid_roll_ads():
            while True:
                time.sleep(900)  # 15 minutes gap
                print("Mid-roll Ad Triggered")

        threading.Thread(target=mid_roll_ads, daemon=True).start()

    def search_google(self, instance):
        self.start_movie_session()
        query = urllib.parse.quote(self.input_box.text)
        webbrowser.open(f"https://www.google.com/search?q=watch+full+movie+{query}")

    def search_youtube(self, instance):
        self.start_movie_session()
        query = urllib.parse.quote(self.input_box.text)
        webbrowser.open(
            f"https://www.youtube.com/results?search_query=full+movie+{query}"
        )

    def download_movie(self, instance):
        self.start_movie_session()
        query = urllib.parse.quote(self.input_box.text)
        webbrowser.open(f"https://www.google.com/search?q=download+movie+{query}")

    def open_ott(self, url):
        self.start_movie_session()
        webbrowser.open(url)

    def share_app(self, instance):
        print("Share App Link Triggered")


if __name__ == "__main__":
    LinkMovieApp().run()

